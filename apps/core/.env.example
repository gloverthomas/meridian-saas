VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Required for local BFF (npm run api). Vite proxy injects it; never expose to the browser.
MERIDIAN_BFF_DEMO_TOKEN=local-demo-token-change-me
# Grok (xAI) for Core AI Assistant — loaded by server/server.mjs and Vercel api/ from env.
# Never commit the real key. Restart: npm run api
XAI_API_KEY=
# XAI_MODEL=grok-4-fast-non-reasoning
